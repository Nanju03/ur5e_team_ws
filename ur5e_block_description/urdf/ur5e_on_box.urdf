<?xml version='1.0' encoding='utf-8'?>
<robot name="ur5e_on_box">
  <!--
  UR5e + DH Robotics AG95 on a fixed box. Units: metres and radians.
  Box size: X=2.000, Y=1.000, Z=0.800; bottom at world Z=0.
  world_to_workbench places the box centre at world Z=0.400.
  base_joint places the UR5e base at (0, 0, 0.400) in workbench,
  so the robot base is centred on the top at world Z=0.800.
  Edit base_joint X/Y/yaw to move the robot on the box.
  UR5e: existing Universal Robots ur_description geometry and kinematics.
  AG95 source: dh_ag95_gripper_ros2/dh_ag95_description/urdf/dh_ag95_macro.xacro.
  gripper_base_joint fixes ag95_base_link to tool0 with identity transform.
  This is a nominal direct mount; no extra adapter thickness is assumed.
  grasp_link is the model TCP, 0.190 m along the AG95 base Z axis.
  Gripper driver joint: left_outer_knuckle_joint, 0.0=open, 0.93=closed (rad).
  The other five moving gripper joints retain the source mimic relations.
  Geometry, inertia and URDF mimic joints are retained for MoveIt/RViz.
  No hardware/serial driver, ros2_control plugin or Gazebo loop joints are included.
  Arm group: base_link to tool0. Put the AG95 links in a separate gripper group.
  Root world is already fixed; an additional virtual joint is unnecessary.
-->
  <link name="world" />
  <link name="workbench">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="2.0 1.0 0.8" />
      </geometry>
      <material name="workbench_gray">
        <color rgba="0.55 0.58 0.62 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="2.0 1.0 0.8" />
      </geometry>
    </collision>
  </link>
  <joint name="world_to_workbench" type="fixed">
    <parent link="world" />
    <child link="workbench" />
    <origin rpy="0 0 0" xyz="0 0 0.4" />
  </joint>
  <link name="base_link" />
