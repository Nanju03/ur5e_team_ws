      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/shoulder.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="3.761" />
