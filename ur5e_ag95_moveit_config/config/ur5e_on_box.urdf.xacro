<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_on_box">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ur5e_on_box urdf file -->
    <xacro:include filename="$(find ur5e_block_description)/urdf/ur5e_on_box.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="ur5e_on_box.ros2_control.xacro" />


    <xacro:ur5e_on_box_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
